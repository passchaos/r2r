# syntax=docker/dockerfile:1
FROM ubuntu:24.04

# Update default packages
RUN apt-get update

# Get Ubuntu packages
RUN apt-get install -y \
    build-essential \
    curl \
    libclang-dev \
    python3

# Get Rust
RUN curl --proto '=https' --tlsv1.2 https://sh.rustup.rs -sSf | bash -s -- -y --default-toolchain none
RUN echo 'source $HOME/.cargo/env' >> $HOME/.bashrc

COPY rust-toolchain.toml /r2r/rust-toolchain.toml
RUN . "$HOME/.cargo/env" && cd /r2r && rustup toolchain install

COPY . /r2r
RUN chmod +x /r2r/tests/test.bash
ENTRYPOINT [ "/r2r/tests/test.bash" ]
